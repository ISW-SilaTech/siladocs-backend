# ============================================================================
# SilaDocs Fabric Middleware - Variables de Entorno
# ============================================================================

# Configuración del Middleware
MIDDLEWARE_HOST=0.0.0.0
MIDDLEWARE_PORT=8000
MIDDLEWARE_RELOAD=True
LOG_LEVEL=INFO

# ============================================================================
# Configuración de Hyperledger Fabric (TODO: Actualizar con red real)
# ============================================================================

# URL base de Fabric (actualizarás esto cuando tengas la red real)
FABRIC_API_URL=http://fabric-ca:7054

# Credenciales y rutas de certificados (para producción)
# FABRIC_MSP_PATH=/path/to/msp
# FABRIC_TLS_CERT=/path/to/tlscert.pem
# FABRIC_CHANNEL_NAME=siladocs-channel
# FABRIC_CHAINCODE_NAME=siladocs-cc

# ============================================================================
# Configuración de Base de Datos (Opcional: para audit log)
# ============================================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/fabric_audit

# ============================================================================
# Configuración de Logging
# ============================================================================

LOG_FORMAT=json
LOG_FILE=/var/log/fabric-middleware/app.log
